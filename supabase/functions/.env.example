# Set these through Supabase Dashboard > Edge Functions > Secrets.
# Generate hashes with pnpm passwords. Never use plaintext here.
AUTHOR_PASSWORD_1_HASH=
AUTHOR_PASSWORD_2_HASH=
ALLOWED_ORIGINS=https://USERNAME.github.io
# Optional until automatic publication is enabled.
GITHUB_OWNER=USERNAME
GITHUB_REPO=outdesign-site
GITHUB_WORKFLOW=deploy.yml
# Fine-grained token, restricted to this repository, Actions: write.
GITHUB_DISPATCH_TOKEN=
