# Public HTTPS URL of the deployed studio-api Edge Function (no trailing slash).
# Leave blank for local development; the local API uses /api.
PUBLIC_API_URL=
# For a project repository use https://USERNAME.github.io and /REPOSITORY.
SITE_URL=http://localhost:4321
BASE_PATH=/
# CI should set to true once a real backend has been configured.
CONTENT_REQUIRED=false
