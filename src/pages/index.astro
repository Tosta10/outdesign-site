---
import { SiteRenderer } from '../components/SiteRenderer.tsx';
import { loadPublicContent } from '../lib/content.ts';
import '../styles/site.css';
const { content, version } = await loadPublicContent();
const base = import.meta.env.BASE_URL;
const api = (import.meta.env.PUBLIC_API_URL || (import.meta.env.DEV ? '/api' : '')).replace(/\/$/, '');
const canonical = new URL(base, Astro.site || Astro.url);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="description" content={content.settings.description} />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={content.settings.siteTitle} />
    <meta property="og:description" content={content.settings.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{content.settings.siteTitle}</title>
  </head>
  <body data-api={api} data-base={base} data-version={version}>
    <div id="public-site"><SiteRenderer content={content} api={api} base={base} /></div>
    <div id="studio-root"></div>
    <script>
      import { initViewer } from '../lib/viewer';
      initViewer(document);
      let opening = false;
      async function launchStudio() {
        if (opening) return;
        opening = true;
        try {
          // This page has no hydrated React island. Initialize Fast Refresh only
          // when manually mounting the editor in development, before JSX imports.
          if (import.meta.env.DEV) {
            const refreshUrl = '/@react-refresh';
            const { default: runtime } = await import(/* @vite-ignore */ refreshUrl);
            runtime.injectIntoGlobalHook(window);
            Object.assign(window, { $RefreshReg$: () => {}, $RefreshSig$: () => (type: unknown) => type, __vite_plugin_react_preamble_installed__: true });
          }
          const { openStudio } = await import('../editor/bootstrap'); await openStudio();
        }
        catch { window.alert('編輯器載入失敗，請重新整理後再試。'); }
        finally { opening = false; }
      }
      document.addEventListener('click', event => {
        if ((event.target as Element).closest('[data-studio-launch]')) launchStudio();
      });
      document.addEventListener('keydown', event => {
        if (event.altKey && event.key.toLowerCase() === 'e') { event.preventDefault(); launchStudio(); }
      });
    </script>
  </body>
</html>
